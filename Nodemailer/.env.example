# Copy this file to .env and fill in real values.
# GMAIL_APP_PASSWORD: use a Google App Password (requires 2-Step Verification enabled
# on the Gmail account). Generate it at https://myaccount.google.com/apppasswords
# RECIPIENT_EMAIL: optional. If left empty, enquiries are sent to GMAIL_USER.

GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
RECIPIENT_EMAIL=
PORT=3001
